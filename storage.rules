rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isConversationParticipant(conversationId) {
      return request.auth != null
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/conversations/$(conversationId)
        ).data.participantIds;
    }

    match /conversations/{conversationId}/audio/{messageId}/{fileName} {
      allow read: if isConversationParticipant(conversationId);
      allow create: if isConversationParticipant(conversationId)
        && request.resource.size > 0
        && request.resource.contentType.matches('audio/.*');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

