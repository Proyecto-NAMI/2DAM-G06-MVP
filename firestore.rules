rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedPhoneE164(phoneE164) {
      return request.auth.token.phone_number is string
        && phoneE164 == request.auth.token.phone_number
        && phoneE164.matches('^\\+[1-9][0-9]{6,14}$');
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participantIds;
    }

    function isMessageUuid(messageId) {
      return messageId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
    }

    function isValidTextMessage(messageId) {
      return request.resource.data.keys().hasOnly([
          'clientMessageId', 'senderId', 'type', 'text', 'createdAt', 'status'
        ])
        && request.resource.data.clientMessageId == messageId
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.type == 'text'
        && request.resource.data.text is string
        && request.resource.data.text.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'sent';
    }

    function isValidAudioMessage(conversationId, messageId) {
      return request.resource.data.keys().hasOnly([
          'clientMessageId', 'senderId', 'type', 'durationMillis', 'sizeBytes',
          'contentType', 'storagePath', 'createdAt', 'status'
        ])
        && request.resource.data.clientMessageId == messageId
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.type == 'audio'
        && request.resource.data.durationMillis is int
        && request.resource.data.durationMillis > 0
        && request.resource.data.durationMillis <= 120000
        && request.resource.data.sizeBytes is int
        && request.resource.data.sizeBytes > 0
        && request.resource.data.sizeBytes <= 5 * 1024 * 1024
        && request.resource.data.contentType == 'audio/mp4'
        && request.resource.data.storagePath ==
          'conversations/' + conversationId + '/audio/' + messageId + '/note.m4a'
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'sent';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && (!('phoneE164' in request.resource.data)
          || hasVerifiedPhoneE164(request.resource.data.phoneE164));
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && (!('phoneE164' in request.resource.data)
          || hasVerifiedPhoneE164(request.resource.data.phoneE164))
        && (!('phoneE164' in resource.data)
          || ('phoneE164' in request.resource.data
            && request.resource.data.phoneE164 == resource.data.phoneE164));
      allow delete: if false;

      match /contacts/{contactId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /conversations/{conversationId} {
      // Solo la callable openConversation, mediante Admin SDK, puede crear una
      // conversación después de validar un contacto linked del propietario.
      allow create: if false;
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);
        allow create: if isConversationParticipant(conversationId)
          && isMessageUuid(messageId)
          && (isValidTextMessage(messageId) || isValidAudioMessage(conversationId, messageId));
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
